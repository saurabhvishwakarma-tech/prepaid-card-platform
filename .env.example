# Copy to .env (git-ignored) and replace every value. Never commit .env.

# PostgreSQL superuser: used by the container and for admin tasks only, never by apps
POSTGRES_ADMIN_USER=platform_admin
POSTGRES_ADMIN_PASSWORD=change-me

# One login user per database (users: core_user, history_user, rewards_user, notification_user)
CORE_DB_PASSWORD=change-me
HISTORY_DB_PASSWORD=change-me
REWARDS_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me