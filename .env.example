# Copy to .env (git-ignored) and replace every value. Never commit .env.

# PostgreSQL superuser: used by the container and for admin tasks only, never by apps
POSTGRES_ADMIN_USER=platform_admin
POSTGRES_ADMIN_PASSWORD=change-me

# One login user per database (users: core_user, history_user, rewards_user, notification_user)
CORE_DB_PASSWORD=change-me
HISTORY_DB_PASSWORD=change-me
REWARDS_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me


# Card data keys (base64 of 32 random bytes each: openssl rand -base64 32).
# Never change them once cards exist, or stored card numbers can no longer be decrypted.
CARD_PAN_ENCRYPTION_KEY=change-me
CARD_PAN_HASH_KEY=change-me
CARD_CVV_KEY=change-me


# Credentials the card network (our simulator) uses to call core over gRPC
NETWORK_CLIENT_ID=card-network-simulator
NETWORK_CLIENT_SECRET=change-me

# Stripe test mode (Dashboard > Developers > API keys, Test mode on). Never a live key.
STRIPE_SECRET_KEY=sk_test_change-me
# Printed by: stripe listen --print-secret
STRIPE_WEBHOOK_SECRET=whsec_change-me